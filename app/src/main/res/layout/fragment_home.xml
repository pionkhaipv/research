<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btn_setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_notification_manager"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notification Manager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_running_apps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Running Apps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_notification_manager" />

    <Button
        android:id="@+id/btn_ad_detector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go to ad detector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_running_apps" />

    <Button
        android:id="@+id/btn_check_hidden_apps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check Hidden Apps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_ad_detector" />

    <Button
        android:id="@+id/btn_show_concern"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show concern"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_check_hidden_apps" />

</androidx.constraintlayout.widget.ConstraintLayout>
