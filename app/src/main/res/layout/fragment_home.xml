<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_blue_dot" />

        <ImageView
            android:id="@+id/iv_icon_app"
            android:layout_width="@dimen/_32dp"
            android:layout_height="@dimen/_32dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginTop="@dimen/_17dp"
            android:src="@drawable/ic_app_small_home"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:fontFamily="@font/font_700"
            android:text="@string/popup_detector"
            android:textAllCaps="true"
            android:textColor="#7C603F"
            android:textSize="@dimen/_24sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_icon_app"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_icon_app"
            app:layout_constraintTop_toTopOf="@id/iv_icon_app" />

        <ImageView
            android:id="@+id/btn_setting"
            android:layout_width="@dimen/_32dp"
            android:layout_height="@dimen/_32dp"
            android:layout_marginEnd="@dimen/_12dp"
            android:padding="@dimen/_4dp"
            android:src="@drawable/ic_setting_home"
            app:layout_constraintBottom_toBottomOf="@id/iv_icon_app"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_icon_app" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_icon_app">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_56dp">

                <FrameLayout
                    android:id="@+id/layoutAdsMiddle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="@dimen/_16dp"
                    app:layout_constraintDimensionRatio="360:70"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <FrameLayout
                        android:id="@+id/adViewGroupMiddle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom"
                        android:background="@color/bg_ads">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/loading_ads"
                            android:textColor="@color/black" />

                    </FrameLayout>

                </FrameLayout>

                <com.tistory.zladnrms.roundablelayout.RoundableLayout
                    android:id="@+id/btn_popup_detector"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="@dimen/_16dp"
                    android:layout_marginTop="@dimen/_16dp"
                    app:cornerAll="@dimen/_8dp"
                    app:layout_constraintDimensionRatio="382:164"
                    app:layout_constraintTop_toBottomOf="@id/layoutAdsMiddle">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bg_pop_up_ads_home" />

                        <ImageView
                            android:id="@+id/iv_speaker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_16dp"
                            android:layout_marginTop="@dimen/_16dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_ad_popup_ads_home"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.3" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/_8dp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_right"
                            app:layout_constraintStart_toEndOf="@id/iv_speaker"
                            app:layout_constraintTop_toTopOf="@id/iv_speaker">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_600"
                                android:text="@string/popup_detector"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_20sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_500"
                                android:text="@string/scan_popup_ad"
                                android:textColor="#D6E9F4"
                                android:textSize="@dimen/_14sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_arrow_right"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_9dp"
                            android:layout_marginEnd="@dimen/_9dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_arrow_right_home"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.09" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.tistory.zladnrms.roundablelayout.RoundableLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16dp"
                    android:layout_marginTop="@dimen/_16dp"
                    app:layout_constraintTop_toBottomOf="@id/btn_popup_detector">

                    <include
                        android:id="@+id/btn_check_hidden_apps"
                        layout="@layout/item_feature_home"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="156:92"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.47" />

                    <include
                        android:id="@+id/btn_notification_control"
                        layout="@layout/item_feature_home"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="156:92"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.47" />

                    <include
                        android:id="@+id/btn_hibernate_app"
                        layout="@layout/item_feature_home"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_16dp"
                        app:layout_constraintDimensionRatio="156:92"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btn_check_hidden_apps"
                        app:layout_constraintWidth_percent="0.47" />

                    <include
                        android:id="@+id/btn_show_concern"
                        layout="@layout/item_feature_home"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_16dp"
                        app:layout_constraintDimensionRatio="156:92"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btn_check_hidden_apps"
                        app:layout_constraintWidth_percent="0.47" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
